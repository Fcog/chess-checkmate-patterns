---
import { site } from '../lib/site';
import Page from '../layouts/Page.astro';
---

<Page
  title={`Page not found | ${site.name}`}
  description="This page doesn’t exist. Browse the chess patterns or try the practice puzzles."
  path="/404"
>
  <h1>Page not found</h1>
  <div id="not-found">
    <p>This page doesn’t exist — maybe the king escaped.</p>
    <p>
      <a href="/">Browse the chess patterns</a> or <a href="/checkmates/practice">try the practice puzzles</a>.
    </p>
  </div>
</Page>

<script>
  // A puzzle link from an old newsletter whose puzzle was removed (spec edge case
  // "Puzzle removed or changed"): offer that topic's practice instead.
  document.addEventListener('astro:page-load', () => {
    const box = document.getElementById('not-found');
    const match = location.pathname.match(/^\/(checkmates|tactics|attacks)\/practice\/[a-z0-9]+$/);
    if (!box || !match) return;
    const topic = match[1];
    box.innerHTML =
      '<p>This puzzle is no longer available.</p>' +
      `<p><a href="/${topic}/practice">Try today’s ${topic} practice puzzles</a> instead.</p>`;
  });
</script>

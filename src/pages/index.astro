---
import { Header } from '../components/react/Header';
import { NewsletterSignup } from '../components/react/NewsletterSignup';
import Base from '../layouts/Base.astro';
import { exercises } from '../lib/exercises';
import { motifPath, motifsOf } from '../lib/motifs';
import { site } from '../lib/site';
import { practicePath, topics } from '../lib/topics';
---

<Base
  title={`${site.name} – Learn & Practice Checkmates, Tactics and Attacks`}
  description="Learn the classic chess checkmate patterns, tactics like forks and pins, and attacks like the Greek gift on an interactive board, then test yourself with blind practice puzzles."
  path="/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: site.name,
    url: Astro.site?.href,
    description:
      'Learn chess checkmate patterns, tactics and attacking ideas, and practice them with interactive puzzles.',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Any',
    inLanguage: 'en',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  }}
>
  <div class="app">
    <Header />
  </div>

  <article class="page-text legal">
    <h1>Learn chess patterns you can spot in a real game</h1>
    <p>
      Strong players don’t calculate everything from scratch — they recognise the pattern. Each
      motif here is a short puzzle on an interactive board: find the move, get a hint if you need
      one, and read how it works once you’ve solved it. Every topic also has a Practice section,
      where {exercises.length} positions hide which motif you’re looking at.
    </p>

    <NewsletterSignup client:load />

    <ul class="topic-cards">
      {
        topics.map((topic) => {
          const list = motifsOf(topic.id);
          return (
            <li>
              <h2>
                <a href={topic.path}>{topic.name}</a>{' '}
                <span class="badge">{list.length}</span>
              </h2>
              <p>{topic.intro}</p>
              <p class="modes topic-actions">
                <a class="mode" href={topic.path}>Learn</a>
                <a class="mode" href={practicePath(topic.id)}>
                  Practice ({exercises.filter((ex) => ex.topic === topic.id).length})
                </a>
              </p>
              <ul class="link-list">
                {list.slice(0, 8).map((m) => (
                  <li>
                    <a href={motifPath(m)}>{m.name}</a>
                  </li>
                ))}
                {list.length > 8 && (
                  <li>
                    <a href={topic.path}>All {list.length} →</a>
                  </li>
                )}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </article>
</Base>

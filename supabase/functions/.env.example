# Copy to supabase/functions/.env.local for `supabase functions serve --env-file …`,
# and set the same names in production with `supabase secrets set`.
# Meanings: specs/001-daily-puzzle-newsletter/contracts/http-api.md (Secrets).

# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=re_xxx
# Sender, on the verified newsletter subdomain.
FROM_EMAIL="Chess Patterns <puzzles@mail.chess-patterns.com>"
# The site, no trailing slash. Used for CORS, links and the puzzle catalogue.
SITE_URL=http://localhost:4321
# Extra origins allowed to call the browser-facing functions, comma-separated (optional).
ALLOWED_ORIGINS=http://localhost:4321
# Key for the scrambled IP address used by the sign-up rate limit. Any long random string.
IP_HASH_SECRET=change-me
# Bearer token the cron jobs send to daily-newsletter. Also stored in Vault.
CRON_SECRET=change-me
# Signing secret of the Resend webhook (starts with whsec_).
RESEND_WEBHOOK_SECRET=whsec_xxx
# Only for local testing: send to a mock instead of Resend (see quickstart.md). Leave unset in production.
# RESEND_API_URL=http://host.docker.internal:8787
# How long one daily-newsletter run sends before handing over to a new run (ms).
SEND_TIME_BUDGET_MS=120000
